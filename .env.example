PORT=3000
BASE_PATH=            # e.g. /hub, empty for host root
TOOLHUB_CONFIG=./toolhub.config.js
LOG_LEVEL=info
METRICS_BEARER_TOKEN= # /metrics is 404 when unset

AUTH_MODE=none        # none | oidc
SESSION_SECRET=       # >= 32 chars, required for oidc
OIDC_ISSUER_URL=https://idp.example.org
OIDC_CLIENT_ID=toolhub
OIDC_CLIENT_SECRET=
OIDC_CLIENT_AUTH=post # post (client_secret_post) | basic (client_secret_basic)
OIDC_REDIRECT_URI=https://tools.example.org/hub/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://tools.example.org/hub/auth/signed-out
OIDC_GROUPS_CLAIM=groups

STORAGE_DRIVER=local  # local | s3
STORAGE_LOCAL_DIR=./media
S3_ENDPOINT=https://minio.example.org
S3_REGION=us-east-1
S3_BUCKET=toolhub-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_URL_TTL_SECONDS=3600
